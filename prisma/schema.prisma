generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String   @default("tag")
  color       String   @default("#6366F1")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deals       Deal[]

  @@map("categories")
}

model Deal {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  description       String
  shortDescription  String?
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  brandName         String
  brandUrl          String?
  logoUrl           String?
  dealUrl           String
  couponCode        String?
  discountType      String   @default("OTHER") // PERCENTAGE, FIXED, FREE_TIER, LIFETIME, OTHER
  discountValue     String? // e.g. "20%" or "$10"
  originalPrice     String?
  discountedPrice   String?
  expiryDate        DateTime?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  isFeatured        Boolean  @default(false)
  submittedByName   String?
  submittedByEmail  String?
  notes             String? // admin-only notes
  clicks            Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  approvedAt        DateTime?
  brokenReportedAt  DateTime? // first user "broken deal" report (rate-limited)
  brokenReportCount Int      @default(0) // total user reports (admin visibility)

  @@index([status])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([slug])
  @@map("deals")
}

// F021: TOTP 2FA enrollment for the admin login (single-admin deployment —
// env credentials, no users table). Singleton row keyed by subject="admin".
// totpSecret is AES-256-GCM encrypted at rest (lib/admin-2fa.ts, per-row
// random scrypt salt — SEC-02); recoveryCodes is a JSON array of SHA-256
// {hash, usedAt} digests — never plaintext codes.
model Admin2FA {
  id               String   @id @default(cuid())
  subject          String   @unique
  totpSecret       String
  lastUsedTimestep Int? // SEC-01 replay guard: last successfully-used TOTP timestep; a code whose timestep ≤ it is rejected
  recoveryCodes    String   @default("[]")
  enrolledAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("admin_2fa")
}
