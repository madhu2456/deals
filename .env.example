# Local: relative SQLite file under prisma/
DATABASE_URL="file:./dev.db"
# Docker/production (volume at /app/data):
# DATABASE_URL="file:/app/data/deals.db"

# Admin credentials for the dashboard
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-in-production"
ADMIN_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"
# Admin session JWT lifetime in hours (default 24; max 720 / 30 days)
# ADMIN_JWT_TTL_HOURS=24

# Canonical site URL (used in sitemap, robots, Open Graph, JSON-LD)
# Production: https://deals.madhudadi.in  |  Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://deals.madhudadi.in"

# HOST port for Docker publish (localhost). Not the port inside the container.
# Server: portfolio/madhudadi.in=3000, blog=3001, deals=3002, enroller=8000
APP_PORT=3002

# Seed categories on container start (set false after first deploy)
# RUN_SEED=false

# Optional: Google Search Console verification meta content
# GOOGLE_SITE_VERIFICATION=""

# IndexNow key for instant indexing pings (Bing/Yandex/Seznam).
# Must match public/<key>.txt (served at /<key>.txt).
# Placeholder only — never commit a real key (F207).
INDEXNOW_KEY="<32-hex-placeholder>"

# Google Tag Manager container ID. Empty or unset disables GTM.
# Set at image build (compose interpolates this into Dockerfile ARG).
NEXT_PUBLIC_GTM_ID=

# Optional Cloudflare Turnstile for /submit (bot protection).
# When BOTH are set: server verifies the token (fail-closed) and the form shows the widget.
# When either is unset: honeypot + timing checks only (submit still works).
# F021: when ADMIN_2FA_ENABLED=true AND both Turnstile keys are set, the ADMIN
# LOGIN also verifies a Turnstile token and renders the widget.
# TURNSTILE_SECRET_KEY=""
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# F021: TOTP 2FA for the admin login. DEFAULT-OFF — unset/false keeps the
# login flow EXACTLY as before (no TOTP field, no Turnstile on login).
# Owner flip sequence (docs/ops/admin-2fa.md): stage Turnstile keys, enroll
# TOTP (pnpm admin:2fa-enroll), verify (pnpm test:admin-2fa + scripts/verify-turnstile-config.ts),
# then set ADMIN_2FA_ENABLED=true and restart. NEVER set before enrolling —
# login would demand a code no authenticator can produce.
# ADMIN_2FA_ENABLED="false"
# Admin TOTP at-rest encryption key (AES-256-GCM). Generate ONCE:
#   openssl rand -base64 32
# REQUIRED whenever ADMIN_2FA_ENABLED=true. Store in the password manager
# AND the server env — never in git. Losing it = re-enroll TOTP (the row's
# secret becomes undecryptable, recovery codes still work via their digests).
# ADMIN_2FA_ENCRYPTION_KEY=""

# Public deal-submission rate limit (per IP; defaults apply if unset)
# Per-IP limit — users behind shared NAT (offices/carriers) share a budget;
# raise SUBMIT_MAX_ATTEMPTS if legitimate bulk submitters are affected.
SUBMIT_MAX_ATTEMPTS=5
SUBMIT_WINDOW_MS=3600000

# Optional: enables SHARED rate-limit buckets across instances via Upstash Redis.
# Absent → in-memory (single-instance) limiting. A misconfigured value logs
# warnings and falls back to in-memory limiting (never blocks traffic).
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-rest-token"

# F018: SQLite backup at-rest encryption (scripts/backup-sqlite.sh).
# REQUIRED in production — the backup script FAILS CLOSED without it (no
# plaintext backup is ever written). Generate ONCE, store in the password
# manager AND the server env (never in git):
#   openssl rand -base64 32
# Losing the key = losing every encrypted backup (*.db.enc).
# BACKUP_ENCRYPTION_KEY=""

# F018 alternative: age keyfile instead of openssl (used automatically when
# both `age` and `age-keygen` are installed; backups then publish as *.db.age).
# Generate once: age-keygen -o /etc/deals/backup.age && chmod 600 /etc/deals/backup.age
# BACKUP_AGE_KEYFILE="/etc/deals/backup.age"
