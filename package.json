{
  "name": "deals-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "//": "pnpm-workspace.yaml is SSOT for overrides on pnpm 10; keep this pnpm.overrides block in sync for CI on pnpm 9.15.9.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:discovery": "tsx scripts/verify-discovery-routes.ts",
    "test:cookie-consent": "tsx scripts/verify-cookie-consent.ts",
    "test:content": "tsx scripts/verify-content.ts",
    "test:jsonld": "tsx scripts/verify-jsonld.ts",
    "test:format": "tsx scripts/verify-format.ts",
    "test:contrast": "tsx scripts/verify-contrast.ts",
    "test:rate-limit": "tsx scripts/verify-rate-limit.ts",
    "test:redis-limiter": "tsx scripts/verify-redis-limiter.ts",
    "test:pagination": "tsx scripts/verify-pagination.ts",
    "test:seed-idempotency": "tsx scripts/verify-seed-idempotency.ts",
    "test:sitemap-stability": "tsx scripts/verify-sitemap-stability.ts",
    "test:turnstile-config": "tsx scripts/verify-turnstile-config.ts",
    "test:gtm-env": "tsx scripts/verify-gtm-env.ts",
    "test:report-endpoint": "tsx scripts/verify-report-endpoint.ts",
    "test:click-origin": "tsx scripts/verify-click-origin.ts",
    "test:secret-scanner": "tsx scripts/verify-secret-scanner.ts",
    "test:approved-at": "tsx scripts/verify-approved-at.ts",
    "test:offer-checker": "tsx scripts/verify-offer-checker.ts",
    "test:restore-scratch": "bash scripts/verify-restore-scratch.sh",
    "check:offers": "tsx scripts/check-offer-validity.ts",
    "test:all": "pnpm test:discovery && pnpm test:content && pnpm test:jsonld && pnpm test:format && pnpm test:contrast && pnpm test:cookie-consent && pnpm test:rate-limit && pnpm test:redis-limiter && pnpm test:pagination && pnpm test:seed-idempotency && pnpm test:sitemap-stability && pnpm test:approved-at && pnpm test:report-endpoint && pnpm test:click-origin && pnpm test:secret-scanner && pnpm test:turnstile-config && pnpm test:gtm-env && pnpm test:offer-checker && pnpm test:restore-scratch && pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "7.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7"
  },
  "pnpm": {
    "overrides": {
      "prisma": "7.9.1",
      "@prisma/client": "7.9.1",
      "postcss": "8.5.26",
      "sharp": "0.35.3"
